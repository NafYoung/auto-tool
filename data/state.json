    "https://mp.weixin.qq.com/s?__biz=MzI2NDE1MDQ1OA%3D%3D&mid=2247507941&idx=1": {
      "url": "https://mp.weixin.qq.com/s?src=11&timestamp=1778675417&ver=6718&signature=AitmeePWdO8yVcsxx4RWatlUmjSLhh3mI1xLBunnCu3KGNeQ8nkW29iz9yJARm16kR3KqoqH0*3cHJoJwHi7L*K4yh30N9fA2YkBB1QjSto7vCP9Aeb4afRNcarfoivz&new=1",
      "normalizedUrl": "https://mp.weixin.qq.com/s?__biz=MzI2NDE1MDQ1OA%3D%3D&mid=2247507941&idx=1",
      "sourceId": "shanghai-tourism-industry-institute",
